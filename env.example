# Duplique ce fichier sous le nom .env et remplace les valeurs.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=REMPLACE_PAR_UNE_CLE_ALEATOIRE_LONGUE_DE_32_CARACTERES_MINIMUM
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Depuis Stripe Dashboard > Developers > API keys (ne jamais publier les clés secrètes).
STRIPE_SECRET_KEY=sk_test_REMPLACE_MOI
STRIPE_WEBHOOK_SECRET=whsec_REMPLACE_MOI

# Crée deux produits et prix récurrents ou ponctuels dans Stripe, puis renseigne les Price IDs.
# Le code ci-dessous attend des paiements uniques en euros.
STRIPE_PRICE_STARTER=price_REMPLACE_MOI
STRIPE_PRICE_CREATOR=price_REMPLACE_MOI
# Si ton prix Pro est enregistré dans Render sous ce nom, le code accepte aussi STRIPE_PRICE_PRO.
# STRIPE_PRICE_PRO=price_REMPLACE_MOI

# Email de support visible aux membres
SUPPORT_EMAIL=bonjour@example.com
